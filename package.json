{
  "name": "offline-dv-photo-studio",
  "private": true,
  "version": "1.0.0",
  "description": "Личное локальное приложение для подготовки фотографии на DV Lottery. Работает офлайн, фото не покидает компьютер.",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup-assets.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "node server.mjs",
    "test": "vitest run",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jpeg-js": "0.4.4",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
